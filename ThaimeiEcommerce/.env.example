# Local Spring backend + MySQL configuration
# Copy to .env and replace values before deploying.
DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/thaimei?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATASOURCE_USERNAME=thaimei
DATASOURCE_PASSWORD=thaimei_local_password

# A Base64-encoded 32-byte value. Generate a unique value for every real environment.
JWT_SECRET=ZGV2LW9ubHktY2hhbmdlLXRoaXMtdG8tYS1yYW5kb20tMzItYnl0ZS1zZWNyZXQ=
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@thaimei.local
ADMIN_SEED_PASSWORD=ChangeThisAdminPassword123!

# Leave blank when payment checkout is not being tested locally.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Vite development server configuration
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080

# Node production-style frontend server configuration
API_PROXY_TARGET=http://127.0.0.1:8080
PORT=4173

# Allowed browser origins for the Spring API. Add your deployed frontend origin when needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
