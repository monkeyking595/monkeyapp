# The development configuration is in the repository-root .env file.
# For a deployed frontend, copy these values to that file or your host's environment.

# Use this when the API is hosted on another origin. Leave blank when proxying API calls.
VITE_API_BASE_URL=https://api.example.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Used by `npm start` to proxy same-origin API calls to the Spring backend.
API_PROXY_TARGET=https://api.example.com
PORT=4173
